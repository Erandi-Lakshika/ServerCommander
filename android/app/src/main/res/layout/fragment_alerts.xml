<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshAlerts"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Alert Configuration Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorControlHighlight"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_alerts"
                            android:tint="@color/brand_emerald" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Email Notification Service"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?android:attr/textColorPrimary" />

                        <TextView
                            android:id="@+id/tvAlertStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_online"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="ACTIVE"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:textColor="@color/brand_emerald" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Recipient Email:"
                        android:textSize="12sp"
                        android:textColor="@color/slate_400" />

                    <TextView
                        android:id="@+id/tvRecipientEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="itkindom.dhomes@gmail.com"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <!-- Dispatch Test Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendTestAlert"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:text="Send Test Email Alert"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/brand_emerald"
                        android:textColor="@color/brand_emerald"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <ProgressBar
                        android:id="@+id/pbSendingTest"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thresholds Grid -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Trigger Thresholds"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- CPU Threshold Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorControlHighlight"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CPU Limit"
                            android:textSize="11sp"
                            android:textColor="@color/slate_400" />

                        <TextView
                            android:id="@+id/tvCpuThreshold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="&gt; 90%"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textSize="16sp"
                            android:textColor="@color/brand_emerald" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- RAM Threshold Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorControlHighlight"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RAM Limit"
                            android:textSize="11sp"
                            android:textColor="@color/slate_400" />

                        <TextView
                            android:id="@+id/tvRamThreshold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="&gt; 90%"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textSize="16sp"
                            android:textColor="@color/color_purple" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Disk Threshold Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorControlHighlight"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disk Limit"
                            android:textSize="11sp"
                            android:textColor="@color/slate_400" />

                        <TextView
                            android:id="@+id/tvDiskThreshold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="&gt; 90%"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textSize="16sp"
                            android:textColor="@color/color_amber" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Recent Alert History -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Incident History"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAlertHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_alert" />

            <TextView
                android:id="@+id/tvNoAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="No incident alerts triggered yet. Server running smoothly!"
                android:textColor="@color/slate_400"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
