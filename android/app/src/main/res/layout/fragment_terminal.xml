<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <!-- Top info & quick action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Web Shell (REST Execution)"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/btnClearTerminal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            android:tint="@color/slate_400"
            android:contentDescription="Clear Output" />
    </LinearLayout>

    <!-- Quick Command Chips ScrollView -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/llQuickCommands"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFree"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="free -h"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/brand_emerald"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipDf"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="df -h"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/brand_emerald"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipUptime"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="uptime"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/brand_emerald"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipPm2"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="pm2 status"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/brand_emerald"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCaddy"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="systemctl status caddy"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/brand_emerald"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipNetstat"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="netstat -tlpn"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/brand_emerald"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Terminal Display Window -->
    <ScrollView
        android:id="@+id/svTerminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/card_bg"
        android:fillViewport="true"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTerminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Welcome to Server Commander Shell\nType a command or pick a preset chip above.\n"
            android:textColor="@color/brand_emerald_light"
            android:textSize="12sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Command Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ "
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/brand_emerald"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etCommand"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="monospace"
                android:hint="Enter shell command..."
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="@color/slate_500"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionSend" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendCommand"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white"
            android:backgroundTint="@color/brand_emerald" />
    </LinearLayout>
</LinearLayout>
